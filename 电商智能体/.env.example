# 复制成 .env 后填写真实值；.env 里含密码，不要提交、不要贴到聊天里
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lumen_store

APP_HOST=127.0.0.1
APP_PORT=3100
STORE_NAME=Lumen 精选商城
SUPPORT_EMAIL=support@lumen.shop
SESSION_SECRET=change-me-in-production
TAX_RATE=0.06
ORDER_HOLD_MINUTES=30
# 超时未付订单的扫描间隔（秒）：服务开着的时候每隔这么久放一次库存，别设成 0
ORDER_SWEEP_SECONDS=60
FREE_SHIPPING_THRESHOLD_CENTS=19900

# 小马的大脑：DeepSeek 走 OpenAI 兼容协议，留空则自动降级为离线意图兜底
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
